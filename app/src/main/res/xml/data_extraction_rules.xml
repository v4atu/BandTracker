<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas de extracción de datos para Android 12 o superior (SPEC §8, Privacidad).
   Se excluye todo en respaldo en la nube y transferencia entre dispositivos:
   el único respaldo es la exportación manual en JSON.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
